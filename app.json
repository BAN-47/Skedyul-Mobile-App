{
  "expo": {
    "scheme": "skedyul",
    "name": "Skedyul-Mobile-App",
    "slug": "Skedyul-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/skedyul-icon-foreground.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.skedyul.faculty",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.skedyul.faculty",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#19316D",
        "foregroundImage": "./assets/skedyul-icon-foreground.png",
        "backgroundImage": "./assets/skedyul-icon-background.svg",
        "monochromeImage": "./assets/skedyul-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/skedyul-favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SKEDYUL to use Face ID for sign-in."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow SKEDYUL to protect your saved sign-in."
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f7c7a8e1-fe81-4f7d-8a09-671f6de96c81"
      }
    },
    "owner": "ban-47"
  }
}
